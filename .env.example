# 环境变量示例（真实 key 放在 .env，不进仓库）
JEV_API_BASE=https://api.commandcode.ai
JEV_API_KEY=你的commandcode-key
JEV_MODEL=typesafe/jev
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
PORT=3200
BANKROLL_USD=200
MIN_BET_USD=1
MAX_BET_USD=10
REQUIRED_EDGE=0.08
EVAL_COOLDOWN_MS=30000
MIN_SECONDS_LEFT=60
MAX_BUY_PRICE=0.92
EXIT_UNREAL_PCT=0.15
EXIT_HOLD_PROB=0.45
EXIT_COOLDOWN_MS=180000
PAPER_MODE=true

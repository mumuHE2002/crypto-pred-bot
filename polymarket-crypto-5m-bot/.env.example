# 环境变量示例（真实 key 放在 .env，不进仓库）
JEV_API_BASE=https://api.commandcode.ai
JEV_API_KEY=你的commandcode-key
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
DEEPSEEK_MAX_TOKENS=32000
DEEPSEEK_TIMEOUT_MS=180000
# 第二确认模型（方向一致才下单）
MUSE_MODEL=meta/muse-spark-1.3-contributor
MUSE_MAX_TOKENS=16000
MUSE_TIMEOUT_MS=180000
PORT=3201
PAPER_MODE=true
BANKROLL_USD=200
MIN_BET_USD=1
PREDICT_AHEAD_SEC=50
HISTORY_WINDOWS=6
PRICE_MIN=0.45
PRICE_MAX=0.55
EVAL_COOLDOWN_MS=30000

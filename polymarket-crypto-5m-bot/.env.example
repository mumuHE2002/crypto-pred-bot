# 环境变量示例（真实 key 放在 .env，不进仓库）
JEV_API_BASE=https://api.commandcode.ai
JEV_API_KEY=你的commandcode-key
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash-fast
DEEPSEEK_MAX_TOKENS=32000
DEEPSEEK_TIMEOUT_MS=180000
PORT=3201
PAPER_MODE=true
BANKROLL_USD=200
MIN_BET_USD=1
PREDICT_AHEAD_SEC=120
PRICE_MIN=0.48
PRICE_MAX=0.52
EVAL_COOLDOWN_MS=30000
